# Template for Streamlit Community Cloud.
# Paste these into the app's Settings -> Secrets box. Do NOT commit a filled-in copy:
# .streamlit/secrets.toml is gitignored for exactly that reason.
#
# These are OPTIONAL. Without them the dashboard still renders every panel from the
# committed artifacts in results/ - only the live account/positions panel switches off.
ALPACA_API_KEY = ""
ALPACA_SECRET_KEY = ""
